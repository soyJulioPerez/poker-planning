{
  "name": "poker-planning",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve web",
    "start:api": "nx serve realtime-api",
    "start:mobile": "cd apps/mobile && npx expo start",
    "build:mobile:preview": "cd apps/mobile && npx eas-cli build --platform android --profile preview",
    "dev:api": "cross-env DYNAMODB_ENDPOINT=http://127.0.0.1:8000 AWS_REGION=us-east-2 TABLE_NAME=poker-planning-rooms nx serve realtime-api",
    "dev:db:up": "docker run -d --name dynamodb-local -p 8000:8000 amazon/dynamodb-local:latest",
    "dev:db:create-table": "cross-env AWS_ACCESS_KEY_ID=dummy AWS_SECRET_ACCESS_KEY=dummy AWS_EC2_METADATA_DISABLED=true aws dynamodb create-table --table-name poker-planning-rooms --attribute-definitions AttributeName=PK,AttributeType=S AttributeName=SK,AttributeType=S --key-schema AttributeName=PK,KeyType=HASH AttributeName=SK,KeyType=RANGE --billing-mode PAY_PER_REQUEST --endpoint-url http://127.0.0.1:8000 --region us-east-2",
    "build": "nx build web",
    "build:api": "nx build realtime-api",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "test:e2e": "npm run e2e:db:up && nx e2e e2e",
    "test:e2e:ci": "npm run e2e:db:up && nx run-many -t build -p web realtime-api && cross-env E2E_TARGET=ci nx e2e e2e",
    "test:e2e:aws": "cross-env E2E_TARGET=aws nx e2e e2e",
    "e2e:db:up": "(docker start dynamodb-local || docker run -d --name dynamodb-local -p 8000:8000 amazon/dynamodb-local:latest) && node tools/scripts/wait-for-dynamodb.mjs && (npm run dev:db:create-table || true)"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "21.2.21",
